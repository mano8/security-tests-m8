# security-tests-m8 live configuration template
# Target stack: /workspace/fa-auth-m8/examples/docker_compose/hardened_m8
#
# Copy this file to .env and fill in the values for your target stack.
# Secrets MUST be changed before running. Never commit a filled-in .env.
# Deployment preflight will flag any remaining 'changethis' placeholders.

# ---------------------------------------------------------------------------
# Auth service entrypoints
# ---------------------------------------------------------------------------

# Public base URL for the auth service.
LIVE_TEST_AUTH_BASE=http://localhost:9000/user

# Internal service-to-service entrypoint that exposes /private/*.
# Hardened stacks block /private at the public Traefik edge (→ 404), so F06
# (per-consumer legacy token-only rejection) must target this URL instead.
# Falls back to LIVE_TEST_AUTH_BASE when unset — correct for simple stacks
# that expose /private directly.
# LIVE_TEST_INTERNAL_AUTH_BASE=http://localhost:9001/user

# Optional: private /health URL for readiness and stack detection. Usually the
# same as LIVE_TEST_AUTH_BASE with /health appended; leave unset to let the
# harness derive it automatically.
# LIVE_TEST_AUTH_HEALTH_URL=http://localhost:9000/user/health/

# ---------------------------------------------------------------------------
# Downstream FastAPI M8 service(s)
# ---------------------------------------------------------------------------

# Single/default service URL.
LIVE_TEST_SVC_BASE=http://localhost:9000/fastapi

# Named service map (JSON). Use LIVE_TEST_DEFAULT_SVC to pick the default.
LIVE_TEST_SVC_BASES={"fastapi":"http://localhost:9000/fastapi"}
LIVE_TEST_DEFAULT_SVC=fastapi

# ---------------------------------------------------------------------------
# Test account — dedicated superuser (never use FIRST_SUPERUSER)
# ---------------------------------------------------------------------------

LIVE_TEST_ADMIN_EMAIL=changethis
LIVE_TEST_ADMIN_PASSWORD=changethis

# ---------------------------------------------------------------------------
# Opt-in secret checks — set to real values from auth.env / api.env
# Unset = those specific tests are skipped.
# ---------------------------------------------------------------------------

# PRIVATE_API_SECRET from auth.env. Required for private-API probes (F01-F05).
# LIVE_TEST_PRIVATE_API_SECRET=changethis

# Per-consumer id (X-Internal-Client) for fa-auth-m8 >= 1.0.0 issuers.
# Set together with LIVE_TEST_PRIVATE_API_SECRET to authenticate under the
# per-consumer model and to enable the F06 legacy-detection check
# (the retired X-Internal-Token-only shape must be rejected with 401).
# Leave unset for legacy single-secret stacks.
# LIVE_TEST_PRIVATE_API_CLIENT_ID=changethis

# Dedicated credential that unlocks the deep /health detail body (token mode,
# Redis/DB reachability, degradation modes). fa-auth-m8 >= 1.0.0 gates that
# detail on HEALTH_DETAIL_CREDENTIAL (X-Internal-Token), decoupled from
# PRIVATE_API_SECRET. Set it so stack detection and token-mode/disclosure
# suites can read the info they need. Falls back to LIVE_TEST_PRIVATE_API_SECRET
# for legacy stacks only.
# LIVE_TEST_HEALTH_DETAIL_CREDENTIAL=changethis

# REFRESH_SECRET_KEY from auth.env. Enables refresh-token and cookie tests.
# LIVE_TEST_REFRESH_SECRET_KEY=changethis

# ---------------------------------------------------------------------------
# Media internal callback ingress (11.1 — MediaInternalExposureSuite)
# ---------------------------------------------------------------------------

# Public path prefix the media stack is mounted under at the reverse proxy
# edge. The suite probes <LIVE_TEST_PUBLIC_BASE>/<prefix>/v1/internal/*.
# Default is 'media'; only set if your edge maps it differently.
# LIVE_TEST_MEDIA_PUBLIC_PREFIX=media

# Worker MEDIA_INTERNAL_SERVICE_TOKEN from media.env (opt-in).
# When set, the suite also proves that a VALID worker token is still blocked
# (proxy-layer 404) at the public edge — i.e. a stolen token cannot be
# replayed remotely. Leave unset to skip the token-present probe.
# LIVE_TEST_MEDIA_INTERNAL_TOKEN=changethis

# ---------------------------------------------------------------------------
# API-key Redis-degraded fail-closed check (11.3 — ApiKeyRedisDegradedSuite)
# ---------------------------------------------------------------------------

# A known-valid plaintext API key minted BEFORE stopping Redis (opt-in).
# The suite verifies that in production/strict posture this key is refused
# with 503 while Redis is down, rather than accepted without rate limiting.
# Leave unset to skip this suite.
# LIVE_TEST_API_KEY=changethis

# Declare that the stack runs production/strict API-key rate limiting.
# Required (together with LIVE_TEST_API_KEY) to enable the fail-closed
# assertion. false = skip.
# LIVE_TEST_API_KEY_STRICT_RATE_LIMIT=true

# ---------------------------------------------------------------------------
# Stack behaviour and preflight settings
# ---------------------------------------------------------------------------

# Request timeout in seconds.
LIVE_TEST_TIMEOUT=10

# Abort collection if auth, services, or credentials are not usable.
LIVE_TEST_FAIL_FAST_PREFLIGHT=true

# Refuse the bootstrap superuser (FIRST_SUPERUSER) as the test account.
LIVE_TEST_FORBID_BOOTSTRAP_SUPERUSER=true

# JSON map of service names to protected endpoint paths; used by
# ConfiguredProtectedEndpointsSuite.
LIVE_TEST_PROTECTED_ENDPOINTS={"fastapi":["/category/","/dashboard/users/activity/"]}

# ---------------------------------------------------------------------------
# Public HTTPS entrypoint and TLS
# ---------------------------------------------------------------------------

# Public edge URL for public-route / header / CORS / media-ingress checks.
LIVE_TEST_PUBLIC_BASE=https://localhost:4430

# TLS verification for HTTPS target URLs.
# false = skip (self-signed local cert); true = system CA; /path/to/ca.crt = bundle.
LIVE_TEST_PUBLIC_TLS_VERIFY=false

# ---------------------------------------------------------------------------
# File-system roots
# ---------------------------------------------------------------------------

# Repo/stack root; used by asymmetric-key tests to read committed keys/private.pem.
LIVE_TEST_REPO_ROOT=/workspace/fa-auth-m8/examples/docker_compose/hardened_m8

# Compose deployment directory scanned by DeploymentPreflightSuite and the
# scan-release / scan-env CLI commands.
LIVE_TEST_DEPLOYMENT_ROOT=/workspace/fa-auth-m8/examples/docker_compose/hardened_m8

# Convenience alias used in conftest.py to locate the hardened stack root.
HARDENED_M8_STACK_ROOT=/workspace/fa-auth-m8/examples/docker_compose/hardened_m8
