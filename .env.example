LIVE_TEST_AUTH_BASE=changethis
LIVE_TEST_AUTH_HEALTH_URL=changethis
LIVE_TEST_ADMIN_EMAIL=changethis
LIVE_TEST_ADMIN_PASSWORD=changethis
LIVE_TEST_SVC_BASE=changethis
LIVE_TEST_SVC_BASES=changethis
LIVE_TEST_DEFAULT_SVC=changethis
LIVE_TEST_TIMEOUT=changethis
LIVE_TEST_REPO_ROOT=changethis
LIVE_TEST_DEPLOYMENT_ROOT=changethis
LIVE_TEST_PUBLIC_BASE=changethis
LIVE_TEST_PUBLIC_TLS_VERIFY=changethis
# Optional opt-in checks. Unset = skip the corresponding suite.
LIVE_TEST_PRIVATE_API_SECRET=changethis
# Per-consumer client id for fa-auth-m8 >= 1.0.0 (X-Internal-Client).
LIVE_TEST_PRIVATE_API_CLIENT_ID=changethis
# Unlocks deep /health detail (token_mode, redis). Without this, require_redis
# and require_token_mode suites skip with an explicit reason.
LIVE_TEST_HEALTH_DETAIL_CREDENTIAL=changethis
LIVE_TEST_REFRESH_SECRET_KEY=changethis
# Public path prefix the media stack is mounted under at the edge (default: media).
LIVE_TEST_MEDIA_PUBLIC_PREFIX=changethis
# MEDIA_INTERNAL_SERVICE_TOKEN — opt-in: proves a VALID worker token is still
# blocked at the public edge for /media/v1/internal/*. Unset = skip that probe.
LIVE_TEST_MEDIA_INTERNAL_TOKEN=changethis
# Opt-in Redis-degraded API-key check (ApiKeyRedisDegradedSuite). Provide a
# known-valid plaintext API key minted BEFORE stopping Redis; the suite asserts
# it fails closed (503) during the outage. Unset = skip that probe.
LIVE_TEST_API_KEY=changethis
# Set true only when the stack runs strict API-key rate limiting
# (production/strict) so a valid key MUST fail closed when Redis is down.
LIVE_TEST_API_KEY_STRICT_RATE_LIMIT=changethis
# AI gateway suite (run --target ai-gateway). Unset = skip those rows.
LIVE_TEST_AI_BASE=changethis
LIVE_TEST_AI_PUBLIC_PREFIX=changethis
LIVE_TEST_AI_CLIENT_ID=changethis
LIVE_TEST_AI_CLIENT_SECRET=changethis
# Path to the stack's test issuer seed file (./secrets/test_issuer_seed).
LIVE_TEST_AI_ISSUER_SEED_FILE=changethis
LIVE_TEST_AI_HEALTH_DETAIL_CREDENTIAL=changethis
LIVE_TEST_AI_METRICS_CREDENTIAL=changethis
LIVE_TEST_AI_PRODUCTION=changethis
# The stub provider (security_tests_m8/ai_stub_provider.py) as the suite and,
# when different, as the gateway reach it.
LIVE_TEST_AI_STUB_BASE=changethis
LIVE_TEST_AI_STUB_PROVIDER_URL=changethis
LIVE_TEST_AI_STUB_CONTROL_TOKEN=changethis
# Container access for the database, log and lifecycle rows.
LIVE_TEST_AI_COMPOSE_PROJECT=changethis
LIVE_TEST_CONTAINER_ENGINE=changethis
LIVE_TEST_AI_DB_SERVICE=changethis
LIVE_TEST_AI_DB_NAME=changethis
LIVE_TEST_AI_AUTH_DB_NAME=changethis
# The stack's AI_TENANT_DAILY_BUDGET_UNITS and AI_MAX_INFLIGHT_PER_CLIENT.
LIVE_TEST_AI_TENANT_DAILY_BUDGET_UNITS=changethis
LIVE_TEST_AI_MAX_INFLIGHT_PER_CLIENT=changethis
